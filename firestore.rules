rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return signedIn() && userDoc().data.role;
    }

    function isOwner() {
      return signedIn() && role() == 'owner';
    }

    function isAdmin() {
      return signedIn() && (role() == 'owner' || role() == 'admin');
    }

    function isTeacher() {
      return signedIn() && (role() == 'teacher' || role() == 'ta');
    }

    function isTeacherOwner(uid) {
      return isTeacher() && uid == request.auth.uid;
    }

    function hasPermission(permission) {
      return isOwner() || isAdmin() ||
        (role() == 'teacher') ||
        (role() == 'ta' && permission in userDoc().data.permissions);
    }

    function activeUser() {
      return signedIn() && userDoc().data.status == 'active';
    }

    function sameUid(data) {
      return signedIn() && data.uid == request.auth.uid;
    }

    function sameStudent(data) {
      return signedIn() && data.studentUid == request.auth.uid;
    }

    function sameTeacher(data) {
      return signedIn() && data.teacherId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAdmin() ||
        request.auth.uid == userId ||
        (isTeacher() &&
          resource.data.assignedTeacherIds is list &&
          request.auth.uid in resource.data.assignedTeacherIds);

      allow create: if signedIn() &&
        request.auth.uid == userId &&
        (
          (request.resource.data.role == 'student' &&
           request.resource.data.status == 'pending') ||
          (request.resource.data.role == 'teacher' &&
           request.resource.data.status == 'pending')
        );

      allow update: if isAdmin() ||
        (signedIn() &&
         request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         request.resource.data.reviewState == resource.data.reviewState);

      allow delete: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if isAdmin() ||
        sameTeacher(resource.data) ||
        resource.data.published == true;

      allow create: if isAdmin() ||
        (isTeacher() &&
         request.resource.data.teacherId == request.auth.uid &&
         request.resource.data.published == false);

      allow update: if isAdmin() ||
        (isTeacher() &&
         resource.data.teacherId == request.auth.uid &&
         request.resource.data.teacherId == resource.data.teacherId &&
         request.resource.data.published == resource.data.published);

      allow delete: if isAdmin() ||
        (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /lessons/{lessonId} {
      allow read: if isAdmin() ||
        sameTeacher(resource.data) ||
        (signedIn() &&
         resource.data.published == true &&
         (
           exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + resource.data.courseId)) ||
           exists(/databases/$(database)/documents/lessonAccess/$(request.auth.uid + '_' + resource.data.courseId + '_' + resource.__name__.split('/').last()))
         ));

      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update, delete: if isAdmin() ||
        (isTeacher() &&
         resource.data.teacherId == request.auth.uid &&
         request.resource.data.teacherId == resource.data.teacherId &&
         request.resource.data.published == resource.data.published);
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() ||
        sameStudent(resource.data) ||
        sameTeacher(resource.data);

      allow create: if isAdmin() ||
        (signedIn() && request.resource.data.studentUid == request.auth.uid);

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.studentUid == request.auth.uid &&
         request.resource.data.studentUid == resource.data.studentUid &&
         request.resource.data.teacherId == resource.data.teacherId);

      allow delete: if isAdmin();
    }

    match /teacherUploads/{uploadId} {
      allow read: if isAdmin() || sameUid(resource.data.ownerUid);
      allow create: if isTeacher() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin() || sameUid(resource.data.ownerUid);
    }

    match /exams/{examId} {
      allow read: if isAdmin() ||
        sameTeacher(resource.data) ||
        (signedIn() && resource.data.published == true);

      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update, delete: if isAdmin() ||
        (isTeacher() &&
         resource.data.teacherId == request.auth.uid &&
         request.resource.data.teacherId == resource.data.teacherId &&
         request.resource.data.published == resource.data.published);
    }

    match /questions/{questionId} {
      allow read: if isAdmin() ||
        sameTeacher(resource.data) ||
        (signedIn() && resource.data.published == true);

      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update, delete: if isAdmin() ||
        (isTeacher() &&
         resource.data.teacherId == request.auth.uid &&
         request.resource.data.teacherId == resource.data.teacherId &&
         request.resource.data.published == resource.data.published);
    }

    match /examAttempts/{attemptId} {
      allow read: if isAdmin() ||
        sameStudent(resource.data) ||
        sameTeacher(resource.data);

      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid;

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }

    match /promoCodes/{codeId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.active == true);

      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.createdByUid == request.auth.uid);

      allow update: if isAdmin() ||
        (signedIn() &&
         resource.data.active == true &&
         request.resource.data.active == false &&
         request.resource.data.usedByUid == request.auth.uid);

      allow delete: if isAdmin();
    }

    match /promoRedemptions/{redemptionId} {
      allow read: if isAdmin() || sameStudent(resource.data);
      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isAdmin() || sameTeacher(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || sameTeacher(resource.data);
      allow create: if isTeacher() &&
        request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || sameUid(resource.data.userId);
      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid);
      allow update: if isAdmin() || sameUid(resource.data.userId);
      allow delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if signedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /deviceSessions/{deviceId} {
      allow read: if isAdmin() || sameUid(resource.data.uid);
      allow create: if isAdmin() || sameUid(request.resource.data.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /lessonNotes/{noteId} {
      allow read: if sameUid(resource.data.uid);
      allow create: if sameUid(request.resource.data.uid);
      allow update, delete: if sameUid(resource.data.uid);
    }

    match /lessonAccess/{accessId} {
      allow read: if isAdmin() || sameStudent(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /lessonProgress/{progressId} {
      allow read: if sameUid(resource.data.uid);
      allow create: if sameUid(request.resource.data.uid);
      allow update: if sameUid(resource.data.uid) &&
        request.resource.data.uid == resource.data.uid;
      allow delete: if sameUid(resource.data.uid);
    }

    match /paymentSubmissions/{paymentId} {
      allow read: if isAdmin() || sameStudent(resource.data);
      allow create: if signedIn() &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.published == true);

      allow create: if isAdmin() ||
        (isTeacher() && request.resource.data.teacherId == request.auth.uid);

      allow update, delete: if isAdmin() ||
        (isTeacher() &&
         resource.data.teacherId == request.auth.uid);
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || sameUid(resource.data.userId);
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() ||
        (sameUid(resource.data.userId) &&
         request.resource.data.userId == resource.data.userId);
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAdmin() || sameUid(resource.data.ownerUid);
      allow create: if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
